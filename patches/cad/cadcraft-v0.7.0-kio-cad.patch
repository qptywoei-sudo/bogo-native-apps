diff --git a/packaging/linux/flatpak/com.kio.cad.yml b/packaging/linux/flatpak/com.kio.cad.yml
new file mode 100644
index 0000000..b679c26
--- /dev/null
+++ b/packaging/linux/flatpak/com.kio.cad.yml
@@ -0,0 +1,67 @@
+# Flatpak manifest for KIO Cad, ready for a Flathub submission.
+#
+# Flatpak builds run offline, so the crate sources must be vendored first. From the repo root:
+#
+#   curl -fsSLO https://raw.githubusercontent.com/flatpak/flatpak-builder-tools/master/cargo/flatpak-cargo-generator.py
+#   python3 flatpak-cargo-generator.py Cargo.lock -o packaging/linux/flatpak/cargo-sources.json
+#   flatpak-builder --user --install --force-clean build-flatpak packaging/linux/flatpak/com.kio.cad.yml
+#   flatpak run com.kio.cad
+#
+# For Flathub, replace the `dir` source with a `git` source pinned to a release tag and commit.
+# The single-file .flatpak attached to each release comes from com.kio.cad.bundle.yml,
+# which repackages the prebuilt release binaries. Keep runtime-version and finish-args identical.
+id: com.kio.cad
+runtime: org.freedesktop.Platform
+runtime-version: '26.08'
+sdk: org.freedesktop.Sdk
+sdk-extensions:
+  - org.freedesktop.Sdk.Extension.rust-stable
+command: cadcraft
+finish-args:
+  # Display: Wayland first; X11 only when no Wayland compositor is running.
+  - --socket=wayland
+  - --socket=fallback-x11
+  # X11 shared memory (MIT-SHM). Without it the X11 fallback is slow or fails.
+  - --share=ipc
+  # GPU access for the wgpu canvas (Vulkan, or GL as a fallback).
+  - --device=dri
+  # Open/Save dialogs go through the file-chooser portal (rfd) and drag-and-drop through the
+  # document portal, so picked files work anywhere without broad filesystem access. Documents
+  # and Pictures are granted so drawings passed by path (the command line, Open Recent, xrefs
+  # and images next to a DXF) work in the usual places.
+  - --filesystem=xdg-documents
+  - --filesystem=xdg-pictures
+  # Deliberately not granted: network (the optional --control server listens on 127.0.0.1 in
+  # the sandbox; `flatpak override --user --share=network com.kio.cad` exposes it to
+  # host agents) and home/host filesystem access.
+build-options:
+  append-path: /usr/lib/sdk/rust-stable/bin
+modules:
+  - name: cadcraft
+    buildsystem: simple
+    build-options:
+      env:
+        CARGO_HOME: /run/build/cadcraft/cargo
+        CARGO_NET_OFFLINE: 'true'
+    build-commands:
+      - cargo --offline build --release --locked -p cadcraft -p cadcraft-cli
+      - install -Dm755 target/release/cadcraft /app/bin/cadcraft
+      - install -Dm755 target/release/cadcraft-cli /app/bin/cadcraft-cli
+      - install -Dm644 packaging/linux/com.kio.cad.desktop /app/share/applications/com.kio.cad.desktop
+      - install -Dm644 packaging/linux/com.kio.cad.mime.xml /app/share/mime/packages/com.kio.cad.xml
+      - mkdir -p /app/share/icons && cp -R assets/app-icon/hicolor /app/share/icons/
+      - >-
+        version=$(awk '/^\[/{p=($0=="[workspace.package]");next} p&&$1=="version"{gsub(/[" ]/,"",$3);print $3;exit}' Cargo.toml);
+        install -d /app/share/metainfo;
+        sed -e "s/@VERSION@/$version/" -e "s/@DATE@/$(date -u +%Y-%m-%d)/"
+        packaging/linux/com.kio.cad.metainfo.xml.in > /app/share/metainfo/com.kio.cad.metainfo.xml
+    sources:
+      - type: dir
+        path: ../../..
+        skip:
+          - target
+          - dist
+          - corpus
+          - build-flatpak
+          - .flatpak-builder
+      - cargo-sources.json
