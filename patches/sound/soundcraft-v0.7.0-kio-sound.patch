diff --git a/packaging/env.sh b/packaging/env.sh
index cb4bcdb64a1ce1d7ba8df707631a6cad1206fba8..3e81b6de768f7113ccd6aa87cfd6a41f284bfc01 100644
--- a/packaging/env.sh
+++ b/packaging/env.sh
@@ -47,7 +47,7 @@ warn() {
 # Copy licence and readme files that exist into a package directory.
 copy_docs() {
   local dest="$1" f
-  for f in README.md LICENSE LICENSE-MIT LICENSE-APACHE NOTICE ATTRIBUTION.md COPYRIGHT; do
+  for f in README.md LICENSE LICENSE-MIT LICENSE-APACHE NOTICE ATTRIBUTION.md NOTICE ATTRIBUTION.md ASSETS.md KIO-FORK.md KIO-FORK.json COPYRIGHT; do
     if [ -f "$ROOT/$f" ]; then cp "$ROOT/$f" "$dest/"; fi
   done
 }
diff --git a/packaging/freebsd/package.sh b/packaging/freebsd/package.sh
index 71af80c37e71a0295d653b123dbdaaf2a94fea30..c9e611a1504cac2699bc6b9730d4e6719918edf1 100755
--- a/packaging/freebsd/package.sh
+++ b/packaging/freebsd/package.sh
@@ -1,5 +1,5 @@
 #!/usr/bin/env bash
-# Build and package SoundCraft for FreeBSD:
+# Build and package KIO Sound for FreeBSD:
 #
 #   $DIST/soundcraft-<version>-freebsd-x86_64.tar.gz   a /usr/local-style tree:
 #       soundcraft-<version>-freebsd-x86_64/{bin, share/applications, share/icons, share/mime,
@@ -17,7 +17,7 @@ set -euo pipefail
 # shellcheck source=../env.sh
 . "$(dirname "${BASH_SOURCE[0]}")/../env.sh"
 LINUX="$ROOT/packaging/linux"
-APP_ID=ai.storyteller.soundcraft
+APP_ID=com.kio.sound
 
 SKIP_BUILD=0
 while [ $# -gt 0 ]; do
@@ -36,7 +36,7 @@ case "$(uname -m)" in
 esac
 BASENAME="soundcraft-$VERSION-freebsd-$ARCH"
 
-echo "==> SoundCraft $VERSION for FreeBSD $ARCH"
+echo "==> KIO Sound $VERSION for FreeBSD $ARCH"
 
 if [ "$SKIP_BUILD" = 0 ]; then
   (cd "$ROOT" && cargo build --release --locked -p soundcraft -p soundcraft-cli)
