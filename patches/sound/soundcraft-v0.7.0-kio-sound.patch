@@ -0,0 +1,63 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
+     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
+<component type="desktop-application">
+  <id>com.kio.sound</id>
+  <metadata_license>CC0-1.0</metadata_license>
+  <project_license>MIT OR Apache-2.0</project_license>
+  <name>KIO Sound</name>
+  <summary>Record, edit and mix audio and MIDI</summary>
+  <developer id="com.kio">
+    <name>KIO</name>
+  </developer>
+  <description>
+    <p>
+      KIO Sound is an open-source, native digital audio workstation. Record, edit and mix
+      multitrack audio and MIDI in Edit and Mix windows that work the way studio engineers expect.
+    </p>
+    <ul>
+      <li>Non-destructive clip editing with fades, playlists, grids and markers</li>
+      <li>A mixer with inserts, sends, buses, automation and metering</li>
+      <li>Built-in EQ, dynamics, reverb, delay, modulation and instruments</li>
+      <li>Imports WAV, AIFF, FLAC, MP3 and MIDI; bounces to disk</li>
+      <li>A headless command line and an MCP server for scripting and agents</li>
+    </ul>
+  </description>
+  <launchable type="desktop-id">com.kio.sound.desktop</launchable>
+  <icon type="stock">com.kio.sound</icon>
+  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
+  <url type="homepage">https://getartcraft.com/apps/soundcraft</url>
+  <url type="bugtracker">https://github.com/storytold/soundcraft/issues</url>
+  <url type="help">https://github.com/storytold/soundcraft</url>
+  <url type="contact">https://discord.gg/artcraft</url>
+  <categories>
+    <category>AudioVideo</category>
+    <category>Audio</category>
+  </categories>
+  <keywords>
+    <keyword>daw</keyword>
