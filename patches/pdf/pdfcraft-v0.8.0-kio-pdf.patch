+#[cfg(test)]
+mod kio_version_tests {
+    use super::*;
+
+    #[test]
+    fn kio_revisions_and_legacy_numeric_versions_keep_their_order() {
+        assert!(is_newer("0.8.0-kio.2", "0.8.0-kio.1"));
+        assert!(!is_newer("0.8.0-kio.1", "0.8.0-kio.1"));
+        assert!(!is_newer("0.8.0-kio.1", "0.8.0-kio.2"));
+        assert!(!is_newer("0.8.0", "0.8.0-kio.1"));
+        assert!(is_newer("0.9.0-kio.1", "0.8.0-kio.99"));
+        assert!(is_newer("v0.1.10", "0.1.9"));
+        assert!(is_newer("1", "0.9.9"));
+        assert!(!is_newer("v0.1.1-beta.2", "0.1.1"));
+        assert!(!is_newer("0.8.0-kio.other", "0.8.0-kio.1"));
+        assert!(!is_newer("0.8.0-kio.18446744073709551616", "0.8.0-kio.1"));
+    }
+
+    #[test]
