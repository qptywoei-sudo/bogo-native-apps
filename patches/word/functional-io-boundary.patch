index 0000000..e4bf82c
--- /dev/null
+++ b/crates/engine/tests/wordml2003_save.rs
@@ -0,0 +1,95 @@
+//! KIO regression: legacy XML format detection stays behind checked I/O.
+#![cfg(not(target_arch = "wasm32"))]
+
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicU64, Ordering};
+
+use serde_json::json;
+use wordcraft_doc::{Document, StoryRef};
+use wordcraft_docx::XmlKind;
+use wordcraft_engine::{Session, file_access, io};
+
+struct Scratch(PathBuf);
+impl Scratch {
+    fn new() -> Self {
+        static NEXT: AtomicU64 = AtomicU64::new(0);
+        let path = std::env::temp_dir().join(format!(
+            "kio-wordml2003-{}-{}",
+            std::process::id(),
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        ));
+        std::fs::create_dir(&path).unwrap();
+        Self(path)
+    }
+    fn path(&self, name: &str) -> PathBuf {
+        self.0.join(name)
+    }
+}
+impl Drop for Scratch {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+
+fn legacy_file(path: &Path) -> Vec<u8> {
+    let bytes = wordcraft_docx::write_wordml2003(&Document::from_text("Original synthetic legacy content.")).unwrap();
+    std::fs::write(path, &bytes).unwrap();
+    bytes
+}
+
+fn edited(path: &Path) -> Session {
+    let mut session = Session::new(Document::from_text("Edited synthetic content."));
+    session.path = Some(path.to_path_buf());
+    session
+}
+
+#[test]
+fn plain_save_keeps_word2003_with_read_and_write_authority() {
+    let scratch = Scratch::new();
+    let path = scratch.path("legacy.xml");
+    legacy_file(&path);
+    let roots = file_access::AutomationRoots::new(Some(&scratch.0), Some(&scratch.0)).unwrap().unwrap();
+    let mut session = edited(&path);
+    file_access::confine(Some(&roots), || {
+        let saved = session.run("file.save", &json!({})).unwrap();
+        assert_eq!(saved["saved"], true);
+    });
+    let bytes = std::fs::read(&path).unwrap();
+    assert_eq!(wordcraft_docx::sniff_xml(&bytes), XmlKind::WordMl2003);
+    assert!(io::open_path(&path).unwrap().plain_text(StoryRef::Body).contains("Edited synthetic content."));
+}
+
+#[test]
+fn plain_save_outside_confined_roots_is_denied_and_preserves_original() {
+    let scratch = Scratch::new();
+    let allowed = scratch.path("allowed");
+    std::fs::create_dir(&allowed).unwrap();
+    let path = scratch.path("outside.xml");
+    let original = legacy_file(&path);
+    let roots = file_access::AutomationRoots::new(Some(&allowed), Some(&allowed)).unwrap().unwrap();
+    let mut session = edited(&path);
+    file_access::confine(Some(&roots), || {
+        assert!(io::open_path(&path).unwrap_err().contains("outside the read root"));
+        let error = session.run("file.save", &json!({})).unwrap_err().to_string();
+        assert!(error.contains("outside the write root"), "{error}");
+    });
+    assert_eq!(std::fs::read(&path).unwrap(), original);
+}
+
+#[test]
+fn plain_save_does_not_sniff_xml_without_read_authority() {
+    let scratch = Scratch::new();
+    let path = scratch.path("write-only.xml");
+    legacy_file(&path);
+    // Write permission does not also grant read permission. The original detector
+    // must return false and use the default Flat OPC format instead of inspecting
+    // existing file content the automation caller was not authorized to read.
+    let roots = file_access::AutomationRoots::new(None, Some(&scratch.0)).unwrap().unwrap();
+    let mut session = edited(&path);
+    file_access::confine(Some(&roots), || {
+        assert!(file_access::check_read(&path.to_string_lossy()).is_err());
+        assert_eq!(session.run("file.save", &json!({})).unwrap()["saved"], true);
+    });
+    assert_eq!(wordcraft_docx::sniff_xml(&std::fs::read(&path).unwrap()), XmlKind::FlatOpc);
+    assert!(io::open_path(&path).unwrap().plain_text(StoryRef::Body).contains("Edited synthetic content."));
+}
