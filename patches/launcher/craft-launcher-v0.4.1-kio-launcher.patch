diff --git a/crates/core/src/kio_registry.rs b/crates/core/src/kio_registry.rs
new file mode 100644
index 0000000..b0ac5f4
--- /dev/null
+++ b/crates/core/src/kio_registry.rs
@@ -0,0 +1,206 @@
+//! KIO's public release registry. App identity, tag, filename, URL, size and digest are bound.
+//! This parser never follows `releases/latest` and never adds an app from remote input.
+
+use crate::catalog::{CraftApp, LAUNCHER, SUITE};
+use crate::feed::{Feed, FeedApp, FeedRelease};
+use crate::platform::{AssetName, PackageKind};
+use crate::version;
+
+pub const REPOSITORY: &str = "qptywoei777-rgb/kio-native-apps";
+pub const REGISTRY_URL: &str = "https://kio-library.vercel.app/downloads/native-apps-manifest.json";
+pub const MAX_REGISTRY_BYTES: usize = 2 * 1024 * 1024;
+
+pub fn app_by_kio_id(id: &str) -> Option<&'static CraftApp> {
+    SUITE.iter().chain(std::iter::once(&LAUNCHER)).find(|a| a.kio_id() == id)
+}
+
+/// A strict registry is independent of a transient GitHub `latest` pointer. Empty registry
+/// entries mean unavailable; missing entries cannot fall back to another app's release.
+pub fn parse(json: &str) -> Result<Feed, String> {
+    if json.len() > MAX_REGISTRY_BYTES {
+        return Err("KIO registry is too large".into());
+    }
+    let raw: serde_json::Value = serde_json::from_str(json).map_err(|_| "KIO registry is not JSON")?;
+    if raw.get("schemaVersion").and_then(serde_json::Value::as_u64) != Some(1) {
+        return Err("unsupported KIO registry schema".into());
+    }
+    let programs = raw.get("programs").and_then(serde_json::Value::as_array).ok_or("KIO programs must be an array")?;
+    if programs.len() > 14 {
+        return Err("too many KIO programs".into());
+    }
+    let mut feed = Feed { kio_registry: true, ..Feed::default() };
+    // A reviewed static release remains valid while offline. It is replaced only by another
+    // valid HTTPS registry; no age or API outage can authorize a different download source.
+    for app in SUITE.iter().chain(std::iter::once(&LAUNCHER)) {
+        feed.apps.insert(app.id.into(), FeedApp { repo: Some(REPOSITORY.into()), fetched_at: Some(0), release: None });
+    }
+    let mut seen = std::collections::BTreeSet::new();
+    for row in programs {
+        let id = row.get("id").and_then(serde_json::Value::as_str).ok_or("missing KIO program id")?;
+        let app = app_by_kio_id(id).ok_or("unknown or private KIO program")?;
+        if !seen.insert(id) {
+            return Err("duplicate KIO program".into());
+        }
+        if row.get("repository").and_then(serde_json::Value::as_str) != Some(REPOSITORY) {
+            return Err("KIO release repository is not allowed".into());
+        }
+        let full_version = row.get("version").and_then(serde_json::Value::as_str).ok_or("missing KIO version")?;
+        let (upstream, revision) = full_version.split_once("-kio.").ok_or("missing KIO release revision")?;
+        let parsed = version::parse(upstream).ok_or("invalid upstream version")?;
+        if !parsed.pre.is_empty()
+            || !parsed.build.is_empty()
+            || upstream != parsed.to_string()
+            || revision.is_empty()
+            || !revision.bytes().all(|b| b.is_ascii_digit())
+            || revision.parse::<u64>().ok().is_none_or(|n| n == 0)
+        {
+            return Err("invalid KIO release version".into());
+        }
+        if let Some(v) = row.get("upstreamVersion")
+            && v.as_str() != Some(upstream)
+        {
+            return Err("KIO upstream version mismatch".into());
+        }
+        let tag = row.get("releaseTag").and_then(serde_json::Value::as_str).ok_or("missing exact KIO tag")?;
+        if tag != format!("{id}-v{full_version}") {
+            return Err("KIO tag belongs to a different app or version".into());
+        }
+        let artifacts = row.get("artifacts").and_then(serde_json::Value::as_array).ok_or("missing KIO artifacts")?;
+        if artifacts.len() > 24 {
+            return Err("too many KIO artifacts".into());
+        }
+        let mut assets = Vec::new();
+        let mut filenames = std::collections::BTreeSet::new();
+        for artifact in artifacts {
+            let url = artifact.get("url").and_then(serde_json::Value::as_str).ok_or("missing KIO artifact URL")?;
+            let name = artifact.get("name").and_then(serde_json::Value::as_str).unwrap_or_else(|| url.rsplit('/').next().unwrap_or_default());
+            let prefix = app.name.replace(' ', "-");
+            if !crate::release::valid_file_name(name)
+                || !filenames.insert(name.to_string())
+                || url != format!("https://github.com/{REPOSITORY}/releases/download/{tag}/{name}")
+            {
+                return Err("KIO artifact URL or filename is not bound to its exact release".into());
+            }
+            let bytes = artifact
+                .get("bytes")
+                .and_then(serde_json::Value::as_u64)
+                .filter(|b| *b > 0 && *b <= 8 * 1024 * 1024 * 1024)
+                .ok_or("invalid KIO artifact size")?;
+            let hash = artifact
+                .get("sha256")
+                .and_then(serde_json::Value::as_str)
+                .filter(|h| h.len() == 64 && h.bytes().all(|b| b.is_ascii_hexdigit()))
+                .ok_or("invalid KIO artifact SHA256")?;
+            let platform = artifact.get("platform").and_then(serde_json::Value::as_str).ok_or("missing KIO artifact platform")?;
+            let arch = artifact.get("arch").and_then(serde_json::Value::as_str).ok_or("missing KIO artifact architecture")?;
+            let kind = artifact.get("kind").and_then(serde_json::Value::as_str).ok_or("missing KIO artifact kind")?;
+            let suffix = match (platform, arch, kind) {
+                ("macos", "arm64" | "aarch64", "dmg") => "macos-arm64.dmg",
+                ("windows", "x64" | "x86_64", "msi") => "windows-x64.msi",
+                ("windows", "x64" | "x86_64", "portable-zip" | "zip") => "windows-x64.zip",
+                // Full application ZIPs are useful downloads; the native installer deliberately
+                // selects the original DMG/MSI path. Source archives are never installers.
+                ("macos", "arm64" | "aarch64", "app-zip" | "zip") => "macos-arm64.zip",
+                _ => return Err("unsupported KIO artifact target".into()),
+            };
+            if name != format!("{prefix}-{full_version}-{suffix}") {
+                return Err("KIO asset name belongs to a different app, version or target".into());
+            }
+            assets.push((name.into(), bytes, url.into(), Some(hash.to_ascii_lowercase())));
+        }
+        let release = (!assets.is_empty()).then(|| FeedRelease {
+            tag: tag.into(),
+            name: format!("{} {full_version}", app.name),
+            html_url: format!("https://github.com/{REPOSITORY}/releases/tag/{tag}"),
+            assets,
+            ..FeedRelease::default()
+        });
+        feed.apps.insert(app.id.into(), FeedApp { repo: Some(REPOSITORY.into()), fetched_at: Some(0), release });
+    }
+    Ok(feed)
+}
+
+/// A KIO-prefixed release filename maps to the original app's machine stem so original
+/// platform preference and install logic remain unchanged.
+pub fn asset_name(name: &str, stems: &[&str]) -> Option<AssetName> {
+    for app in SUITE.iter().chain(std::iter::once(&LAUNCHER)) {
+        if !stems.contains(&app.id) {
+            continue;
+        }
+        let prefix = format!("{}-", app.name.replace(' ', "-"));
+        let Some(rest) = name.strip_prefix(&prefix) else { continue };
+        let (body, kind) = if let Some(b) = rest.strip_suffix(".dmg") {
+            (b, PackageKind::Dmg)
+        } else if let Some(b) = rest.strip_suffix(".msi") {
+            (b, PackageKind::Msi)
+        } else if let Some(b) = rest.strip_suffix(".zip") {
+            (b, PackageKind::PortableZip)
+        } else {
+            continue;
+        };
+        let mut parts = body.rsplitn(3, '-');
+        let arch = parts.next()?;
+        let os = parts.next()?;
+        let v = parts.next()?;
+        version::parse(v)?;
+        let token = match (os, arch, kind) {
+            ("macos", "arm64", PackageKind::Dmg) => "macos-aarch64",
+            ("windows", "x64", PackageKind::Msi | PackageKind::PortableZip) => "windows-x64",
+            _ => continue,
+        };
+        return Some(AssetName { stem: app.id.into(), version: v.into(), token: token.into(), kind });
+    }
+    None
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::feed::FeedAnswer;
+    fn sample() -> String {
+        let name = "KIO-Word-0.7.0-kio.1-windows-x64.msi";
+        serde_json::json!({"schemaVersion":1,"programs":[{"id":"word","version":"0.7.0-kio.1","upstreamVersion":"0.7.0","repository":REPOSITORY,"releaseTag":"word-v0.7.0-kio.1","artifacts":[{"name":name,"platform":"windows","arch":"x86_64","kind":"msi","bytes":123,"sha256":"a".repeat(64),"url":format!("https://github.com/{REPOSITORY}/releases/download/word-v0.7.0-kio.1/{name}")}]}]}).to_string()
+    }
+    #[test]
+    fn valid_registry_binds_app_tag_asset_hash_size_and_missing_apps_are_unavailable() {
+        let feed = parse(&sample()).unwrap();
+        let word = app_by_kio_id("word").unwrap();
+        let FeedAnswer::Fresh(Some(r)) = feed.answer(word, 2_000_000_000) else { panic!("missing release") };
+        assert_eq!(r.version.unwrap().to_string(), "0.7.0-kio.1");
+        assert_eq!(r.assets[0].size, 123);
+        assert_eq!(r.assets[0].sha256.as_deref(), Some("a".repeat(64).as_str()));
+        assert_eq!(feed.answer(app_by_kio_id("grid").unwrap(), 2_000_000_000), FeedAnswer::Fresh(None));
+        assert!(asset_name("KIO-Word-0.7.0-kio.1-windows-x64.msi", &[word.id]).is_some());
+        assert!(asset_name("KIO-Grid-0.7.0-kio.1-windows-x64.msi", &[word.id]).is_none());
+    }
+    #[test]
+    fn malicious_or_mixed_app_registry_never_installs() {
+        for (from, to) in [
+            ("word-v0.7.0-kio.1", "grid-v0.7.0-kio.1"),
+            (REPOSITORY, "other/kio-native-apps"),
+            ("KIO-Word-", "KIO-Grid-"),
+            ("\"bytes\":123", "\"bytes\":0"),
+            ("\"id\":\"word\"", "\"id\":\"studio\""),
+        ] {
+            assert!(parse(&sample().replace(from, to)).is_err(), "{from}");
+        }
+        assert!(parse("{\"schemaVersion\":2,\"programs\":[]}").is_err());
+        let v = sample();
+        let mut row: serde_json::Value = serde_json::from_str(&v).unwrap();
+        let duplicate = row["programs"][0].clone();
+        row["programs"].as_array_mut().unwrap().push(duplicate);
+        assert!(parse(&row.to_string()).is_err());
+    }
+    #[test]
+    fn arm_only_kio_download_is_never_selected_for_an_intel_mac() {
+        use crate::{Arch, Os, Platform};
+        let app = app_by_kio_id("word").unwrap();
+        let name = "KIO-Word-0.7.0-kio.1-macos-arm64.dmg";
+        let release = crate::release::Release {
+            assets: vec![crate::release::Asset { name: name.into(), url: "https://example.invalid/".into(), size: 1, sha256: Some("a".repeat(64)) }],
+            ..Default::default()
+        };
+        assert!(crate::platform::pick_asset(&release, &[app.id], Platform { os: Os::MacOs, arch: Arch::Arm64 }, &[PackageKind::Dmg]).is_some());
+        assert!(crate::platform::pick_asset(&release, &[app.id], Platform { os: Os::MacOs, arch: Arch::X64 }, &[PackageKind::Dmg]).is_none());
+    }
+}
