+
+pub(crate) fn calculate(data: &[u8]) -> [u8; 48] {
+    let mut h = [
+        0xcbbb9d5dc1059ed8_u64,
+        0x629a292a367cd507,
+        0x9159015a3070dd17,
+        0x152fecd8f70e5939,
