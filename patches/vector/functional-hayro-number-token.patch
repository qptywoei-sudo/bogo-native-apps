+    let mut result = [0_u8; 48];
+    for (i, &hash_word) in h.iter().take(6).enumerate() {
+        let bytes = hash_word.to_be_bytes();
+        result[i * 8..(i + 1) * 8].copy_from_slice(&bytes);
+    }
+
+    result
+}
