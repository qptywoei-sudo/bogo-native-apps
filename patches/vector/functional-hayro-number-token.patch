+        let mut reader = Reader::new(b"<< /Length 3 >> stream\nabc\nendstream");
+        let stream = reader
+            .read_with_context::<Stream<'_>>(&ReaderContext::dummy())
+            .unwrap();
+
+        assert_eq!(format!("{stream}"), "Stream (len: 3)");
+    }
+
