+//! Logging macros that optionally forward to the `log` crate.
+
+macro_rules! debug {
+    ($fmt:literal $(, $($arg:expr),* $(,)?)?) => {{
+        #[cfg(feature = "logging")]
+        {
+            ::log::debug!($fmt $(, $($arg),*)?);
+        }
+        #[cfg(not(feature = "logging"))]
+        {
+            $($(let _ = &$arg;)*)?
+        }
+    }};
+}
+
+macro_rules! error {
+    ($fmt:literal $(, $($arg:expr),* $(,)?)?) => {{
+        #[cfg(feature = "logging")]
+        {
+            ::log::error!($fmt $(, $($arg),*)?);
+        }
+        #[cfg(not(feature = "logging"))]
+        {
+            $($(let _ = &$arg;)*)?
+        }
+    }};
+}
+
+macro_rules! warn {
+    ($fmt:literal $(, $($arg:expr),* $(,)?)?) => {{
+        #[cfg(feature = "logging")]
+        {
+            ::log::warn!($fmt $(, $($arg),*)?);
+        }
+        #[cfg(not(feature = "logging"))]
+        {
+            $($(let _ = &$arg;)*)?
+        }
+    }};
+}
