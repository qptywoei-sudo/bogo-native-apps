+
+/// A container for the bytes of a PDF file.
+#[derive(Clone)]
+pub struct PdfData {
+    #[cfg(feature = "std")]
+    inner: Arc<dyn AsRef<[u8]> + Send + Sync>,
+    #[cfg(not(feature = "std"))]
+    inner: Arc<dyn AsRef<[u8]>>,
+}
