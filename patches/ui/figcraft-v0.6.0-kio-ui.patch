diff --git a/packaging/linux/com.kio.ui.metainfo.xml.in b/packaging/linux/com.kio.ui.metainfo.xml.in
new file mode 100644
index 0000000000000000000000000000000000000000..90c7a60bc6cff6460e07963c69faf36fc3228b05
--- /dev/null
+++ b/packaging/linux/com.kio.ui.metainfo.xml.in
@@ -0,0 +1,66 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
+     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
+<component type="desktop-application">
+  <id>com.kio.ui</id>
+  <metadata_license>CC0-1.0</metadata_license>
+  <project_license>MIT OR Apache-2.0</project_license>
+  <name>KIO UI</name>
+  <summary>Design and prototype user interfaces</summary>
+  <developer id="com.kio">
+    <name>KIO</name>
+  </developer>
+  <description>
+    <p>
+      KIO UI is an open-source, native interface design and prototyping tool. Lay out screens
+      on an infinite canvas with frames, auto layout and constraints, build reusable components
+      and variants, and link screens into clickable prototypes.
+    </p>
+    <ul>
+      <li>Frames, vector shapes, text and images on an infinite canvas</li>
+      <li>Auto layout and constraints for responsive designs</li>
+      <li>Components, variants, shared styles and variables</li>
+      <li>Prototyping with interactions and transitions, and a presentation mode</li>
+      <li>Inspect panel with measurements and code snippets; SVG and PNG export</li>
+      <li>Every action is a command, scriptable from a CLI, a JSON control channel and an MCP server</li>
+    </ul>
+  </description>
+  <launchable type="desktop-id">com.kio.ui.desktop</launchable>
+  <icon type="stock">com.kio.ui</icon>
+  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
+  <url type="homepage">https://getartcraft.com/apps/figcraft</url>
+  <url type="bugtracker">https://github.com/storytold/figcraft/issues</url>
+  <url type="help">https://github.com/storytold/figcraft</url>
+  <url type="contact">https://discord.gg/artcraft</url>
+  <categories>
+    <!-- Freedesktop registered categories only ("Design" isn't one; the .desktop file says X-Design). -->
+    <category>Graphics</category>
+    <category>2DGraphics</category>
+    <category>VectorGraphics</category>
+  </categories>
+  <keywords>
