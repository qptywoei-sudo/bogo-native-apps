diff --git a/packaging/linux/flatpak/com.kio.ui.bundle.yml b/packaging/linux/flatpak/com.kio.ui.bundle.yml
new file mode 100644
index 0000000000000000000000000000000000000000..1775944a39f96f6e4f1d78379f5ce55db15954c2
--- /dev/null
+++ b/packaging/linux/flatpak/com.kio.ui.bundle.yml
@@ -0,0 +1,51 @@
+# Flatpak manifest for the single-file bundle attached to every GitHub release
+# (figcraft-<version>-linux-<arch>.flatpak). Build it with packaging/linux/flatpak-bundle.sh.
+#
+# It repackages the release's own Linux tarball (figcraft-<version>-linux-<arch>.tar.gz,
+# built on Ubuntu 22.04 by package.sh) instead of compiling Rust inside flatpak-builder: no
+# network and no vendored crate sources during the build, a few seconds instead of 20+ minutes,
+# and byte-for-byte the same binaries as the AppImage/deb/rpm. The script unpacks the tarball
+# into `stage/` next to a copy of this file. The binaries need glibc >= 2.35 and load X11,
+# Wayland, xkbcommon and Vulkan at runtime; the freedesktop runtime has all of them, and the
+# GPU driver comes from its org.freedesktop.Platform.GL extension.
+#
+# com.kio.ui.yml (same directory) is the from-source manifest for Flathub. Keep
+# runtime-version and finish-args identical in both (packaging-lint checks this).
+id: com.kio.ui
+runtime: org.freedesktop.Platform
+runtime-version: '26.08'
+sdk: org.freedesktop.Sdk
+command: figcraft
+finish-args:
+  # Display: Wayland first; X11 only when no Wayland compositor is running.
+  - --socket=wayland
+  - --socket=fallback-x11
+  # X11 shared memory (MIT-SHM). Without it the X11 fallback is slow or fails.
+  - --share=ipc
+  # GPU access for the wgpu renderer (Vulkan, or GL as a fallback).
+  - --device=dri
+  # Open/Save dialogs go through the file-chooser portal (rfd's xdg-portal backend) and
+  # drag-and-drop through the document portal, so picked files work anywhere without broad
+  # filesystem access. Pictures and Documents are granted so files passed by path (the command
+  # line, Open Recent, "Save" next to the original) work in the usual places.
+  - --filesystem=xdg-pictures
+  - --filesystem=xdg-documents
+  # Deliberately not granted: network (the optional --control server listens on 127.0.0.1 in
+  # the sandbox; `flatpak override --user --share=network com.kio.ui` exposes it to
+  # host agents) and home/host filesystem access.
+modules:
+  - name: figcraft
+    buildsystem: simple
+    build-commands:
+      - install -Dm755 bin/figcraft /app/bin/figcraft
+      # The headless CLI, in tarballs built with apps/figcraft-cli.
+      - if [ -x bin/figcraft-cli ]; then install -Dm755 bin/figcraft-cli /app/bin/figcraft-cli; fi
+      - install -Dm644 share/applications/com.kio.ui.desktop /app/share/applications/com.kio.ui.desktop
+      # .figcraft; the runtime's shared-mime-info already knows SVG, PNG and JPEG.
+      - install -Dm644 share/mime/packages/com.kio.ui.xml /app/share/mime/packages/com.kio.ui.xml
+      # Already has the release's version and date substituted by package.sh.
+      - install -Dm644 share/metainfo/com.kio.ui.metainfo.xml /app/share/metainfo/com.kio.ui.metainfo.xml
+      - mkdir -p /app/share/icons /app/share/doc && cp -R share/icons/hicolor /app/share/icons/ && cp -R share/doc/figcraft /app/share/doc/
+    sources:
+      - type: dir
+        path: stage
diff --git a/packaging/linux/flatpak/com.kio.ui.yml b/packaging/linux/flatpak/com.kio.ui.yml
new file mode 100644
index 0000000000000000000000000000000000000000..a4f366174d9dd1146eca348b5f5a006984b82338
--- /dev/null
+++ b/packaging/linux/flatpak/com.kio.ui.yml
@@ -0,0 +1,73 @@
+# Flatpak manifest for KIO UI, ready for a Flathub submission.
+#
+# Flatpak builds run offline, so the crate sources must be vendored first. From the repo root:
+#
+#   curl -fsSLO https://raw.githubusercontent.com/flatpak/flatpak-builder-tools/master/cargo/flatpak-cargo-generator.py
+#   python3 flatpak-cargo-generator.py Cargo.lock -o packaging/linux/flatpak/cargo-sources.json
+#   flatpak-builder --user --install --force-clean build-flatpak packaging/linux/flatpak/com.kio.ui.yml
+#   flatpak run com.kio.ui
+#
+# For Flathub, replace the `dir` source with a `git` source pinned to a release tag and commit.
+# The single-file .flatpak attached to each release comes from com.kio.ui.bundle.yml,
+# which repackages the prebuilt release binaries. Keep runtime-version and finish-args identical.
+#
+# Official release binaries embed craft-fonts (storytold/craft-fonts, OFL fonts); this from-source
+# build doesn't (add it as a git source and set CRAFT_FONTS_DIR to include it), so it uses the
+# runtime's system fonts.
+id: com.kio.ui
+runtime: org.freedesktop.Platform
+runtime-version: '26.08'
+sdk: org.freedesktop.Sdk
+sdk-extensions:
+  - org.freedesktop.Sdk.Extension.rust-stable
+command: figcraft
+finish-args:
+  # Display: Wayland first; X11 only when no Wayland compositor is running.
+  - --socket=wayland
+  - --socket=fallback-x11
+  # X11 shared memory (MIT-SHM). Without it the X11 fallback is slow or fails.
+  - --share=ipc
+  # GPU access for the wgpu renderer (Vulkan, or GL as a fallback).
+  - --device=dri
+  # Open/Save dialogs go through the file-chooser portal (rfd's xdg-portal backend) and
+  # drag-and-drop through the document portal, so picked files work anywhere without broad
+  # filesystem access. Pictures and Documents are granted so files passed by path (the command
+  # line, Open Recent, "Save" next to the original) work in the usual places.
+  - --filesystem=xdg-pictures
+  - --filesystem=xdg-documents
+  # Deliberately not granted: network (the optional --control server listens on 127.0.0.1 in
+  # the sandbox; `flatpak override --user --share=network com.kio.ui` exposes it to
+  # host agents) and home/host filesystem access.
+build-options:
+  append-path: /usr/lib/sdk/rust-stable/bin
+modules:
+  - name: figcraft
+    buildsystem: simple
+    build-options:
+      env:
+        CARGO_HOME: /run/build/figcraft/cargo
+        CARGO_NET_OFFLINE: 'true'
+        # .cargo/config.toml points CRAFT_FONTS_DIR at ../craft-fonts for local builds; there is
+        # none here, so build without it (a warning, not an error).
+        CRAFT_FONTS_DIR: /nonexistent
+    build-commands:
+      - cargo --offline build --release --locked -p figcraft
+      - install -Dm755 target/release/figcraft /app/bin/figcraft
+      - install -Dm644 packaging/linux/com.kio.ui.desktop /app/share/applications/com.kio.ui.desktop
+      - install -Dm644 packaging/linux/com.kio.ui.mime.xml /app/share/mime/packages/com.kio.ui.xml
+      - mkdir -p /app/share/icons && cp -R assets/app-icon/hicolor /app/share/icons/
+      - >-
+        version=$(awk '/^\[/{p=($0=="[workspace.package]");next} p&&$1=="version"{gsub(/[" ]/,"",$3);print $3;exit}' Cargo.toml);
+        install -d /app/share/metainfo;
+        sed -e "s/@VERSION@/$version/" -e "s/@DATE@/$(date -u +%Y-%m-%d)/"
+        packaging/linux/com.kio.ui.metainfo.xml.in > /app/share/metainfo/com.kio.ui.metainfo.xml
+    sources:
+      - type: dir
+        path: ../../..
+        skip:
+          - target
+          - dist
+          - corpus
+          - build-flatpak
+          - .flatpak-builder
+      - cargo-sources.json
