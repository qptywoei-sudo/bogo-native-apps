+#[cfg(windows)]
+fn same_lock_file(held: &std::fs::File, named: &std::fs::File) -> std::io::Result<bool> {
+    let held = same_file::Handle::from_file(held.try_clone()?)?;
+    let named = same_file::Handle::from_file(named.try_clone()?)?;
+    Ok(held == named)
