-        "github": GITHUB,
-        "issues": ISSUES,
-    })
+    json!({})
 }
 
-/// A link by key (`discord`, `website`, `appPage`, `github`, `issues`).
-pub fn get(key: &str) -> Option<&'static str> {
-    Some(match key {
-        "discord" => DISCORD,
-        "website" => WEBSITE,
-        "appPage" => APP_PAGE,
-        "github" => GITHUB,
-        "issues" => ISSUES,
-        _ => return None,
-    })
+pub fn get(_key: &str) -> Option<&'static str> {
+    None
 }
 
